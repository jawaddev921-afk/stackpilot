# StackPilot Environment Configuration
# Copy this file to .env and adjust values as needed.

# Database connection (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# NextAuth configuration
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Application runtime settings
PORT=3000
NODE_ENV="development"
START_MODE="server"

# Kubernetes / Cluster configuration (Optional for standalone dev)
KUBECONFIG=""
KUBECTL_PATH="kubectl"
K3S_JOIN_TOKEN=""
AGENT_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_PROXY_DEBUG_ENABLED=false
